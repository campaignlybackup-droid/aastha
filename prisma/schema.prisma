generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

/// A single identity table serves both shoppers and staff. Role governs access;
/// a separate `Customer` table would duplicate every column for no benefit.
model User {
  id               String         @id @default(cuid())
  /// E.164 digits, no "+". e.g. "919876543210"
  mobile           String         @unique
  email            String?        @unique
  name             String?
  role             Role           @default(CUSTOMER)
  status           UserStatus     @default(ACTIVE)
  emailVerifiedAt  DateTime?
  mobileVerifiedAt DateTime?
  marketingOptIn   Boolean        @default(false)
  lastLoginAt      DateTime?
  /// Internal staff notes, never shown to the customer.
  notes            String?
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  addresses        Address[]
  auditLogs        AuditLog[]
  carts            Cart[]
  couponUsages     CouponUsage[]
  orders           Order[]
  reviews          Review[]
  sessions         Session[]
  wishlist         WishlistItem[]

  @@index([role])
  @@index([createdAt])
  @@map("users")
}

/// Server-side session records make logout and forced revocation possible.
/// The session cookie carries a signed JWT whose `jti` is this row's id.
model Session {
  id        String    @id @default(cuid())
  userId    String
  expiresAt DateTime
  revokedAt DateTime?
  userAgent String?
  ip        String?
  createdAt DateTime  @default(now())
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("sessions")
}

/// One-time passcodes. The code itself is NEVER stored — only an HMAC of it,
/// peppered with OTP_PEPPER. Verification recomputes the HMAC and compares in
/// constant time.
model OtpRequest {
  id          String     @id @default(cuid())
  /// E.164 mobile or lowercased email
  destination String
  channel     OtpChannel @default(SMS)
  codeHash    String
  expiresAt   DateTime
  attempts    Int        @default(0)
  maxAttempts Int        @default(5)
  consumedAt  DateTime?
  ip          String?
  createdAt   DateTime   @default(now())

  @@index([destination, createdAt])
  @@index([expiresAt])
  @@map("otp_requests")
}

/// Database-backed fixed-window rate limiting. Postgres avoids adding Redis to
/// the deployment for what is a low-volume concern at this store's scale.
model RateLimit {
  id          String   @id @default(cuid())
  /// e.g. "otp:send:919876543210" or "api:checkout:1.2.3.4"
  bucket      String
  count       Int      @default(0)
  windowStart DateTime
  expiresAt   DateTime

  @@unique([bucket, windowStart])
  @@index([expiresAt])
  @@map("rate_limits")
}

model Address {
  id        String    @id @default(cuid())
  userId    String
  /// "Home", "Office"
  label     String?
  name      String
  mobile    String
  line1     String
  line2     String?
  landmark  String?
  city      String
  state     String
  pincode   String
  country   String    @default("India")
  isDefault Boolean   @default(false)
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  /// Soft delete: historical orders reference addresses.
  deletedAt DateTime?
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("addresses")
}

model Category {
  id             String     @id @default(cuid())
  name           String
  slug           String     @unique
  parentId       String?
  description    String?
  imageId        String?
  /// Optional lucide icon for compact category strips.
  iconName       String?
  position       Int        @default(0)
  isActive       Boolean    @default(true)
  isFeatured     Boolean    @default(false)
  seoTitle       String?
  seoDescription String?
  ogImageId      String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  image          Media?     @relation("CategoryImage", fields: [imageId], references: [id])
  ogImage        Media?     @relation("CategoryOgImage", fields: [ogImageId], references: [id])
  parent         Category?  @relation("CategoryTree", fields: [parentId], references: [id])
  children       Category[] @relation("CategoryTree")
  products       Product[]

  @@index([parentId])
  @@index([isActive, position])
  @@map("categories")
}

/// Curated merchandising groups ("Bridal Edit", "Under ₹2,000"). A product can
/// belong to many collections; categories are the single taxonomic home.
model Collection {
  id             String                @id @default(cuid())
  name           String
  slug           String                @unique
  description    String?
  imageId        String?
  position       Int                   @default(0)
  isActive       Boolean               @default(true)
  isFeatured     Boolean               @default(false)
  seoTitle       String?
  seoDescription String?
  createdAt      DateTime              @default(now())
  updatedAt      DateTime              @updatedAt
  image          Media?                @relation("CollectionImage", fields: [imageId], references: [id])
  products       ProductOnCollection[]

  @@index([isActive, position])
  @@map("collections")
}

model ProductOnCollection {
  productId    String
  collectionId String
  position     Int        @default(0)
  collection   Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product      Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@id([productId, collectionId])
  @@index([collectionId, position])
  @@map("product_collections")
}

model Product {
  id               String                @id @default(cuid())
  name             String
  slug             String                @unique
  sku              String                @unique
  brand            String                @default("Aastha Silver & Jewels")
  categoryId       String
  shortDescription String?
  /// Rich text (sanitised HTML).
  description      String?
  tags             String[]              @default([])
  status           ProductStatus         @default(DRAFT)
  isFeatured       Boolean               @default(false)
  publishedAt      DateTime?
  mrpPaise         Int
  pricePaise       Int
  /// GST on silver jewellery is 3% in India.
  taxPercent       Float                 @default(3)
  /// "925 Sterling Silver", "999 Fine Silver"
  silverPurity     String?
  silverWeightGram Float?
  /// Free text, e.g. "18mm x 12mm"
  dimensions       String?
  /// "Rhodium Polished", "Oxidised", "Matte"
  finish           String?
  plating          String?
  stoneType        String?
  stoneColour      String?
  stoneCount       Int?
  occasion         String[]              @default([])
  gender           Gender?
  isAdjustable     Boolean               @default(false)
  careInstructions String?
  warrantyInfo     String?
  authenticityInfo String?
  whatsIncluded    String?
  /// Escape hatch for attributes that do not deserve a column.
  /// Shape: { "label": "value" } — rendered verbatim in the spec table.
  extraSpecs       Json?
  ratingAverage    Float                 @default(0)
  ratingCount      Int                   @default(0)
  /// Units sold; drives "Best Sellers".
  salesCount       Int                   @default(0)
  viewCount        Int                   @default(0)
  seoTitle         String?
  seoDescription   String?
  canonicalUrl     String?
  ogTitle          String?
  ogDescription    String?
  ogImageId        String?
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @updatedAt
  cartItems        CartItem[]
  orderItems       OrderItem[]
  collections      ProductOnCollection[]
  faqs             ProductFaq[]
  images           ProductImage[]
  variants         ProductVariant[]
  category         Category              @relation(fields: [categoryId], references: [id])
  ogImage          Media?                @relation("ProductOgImage", fields: [ogImageId], references: [id])
  reviews          Review[]
  wishlisted       WishlistItem[]

  @@index([status, publishedAt])
  @@index([categoryId, status])
  @@index([pricePaise])
  @@index([salesCount])
  @@index([ratingAverage])
  @@index([isFeatured, status])
  @@index([gender])
  @@index([tags], type: Gin)
  @@map("products")
}

/// Every product has at least one variant, created implicitly for products
/// sold in a single configuration. Inventory lives here and only here.
model ProductVariant {
  id                String          @id @default(cuid())
  productId         String
  sku               String          @unique
  /// Human label shown in the selector, e.g. "Size 14" or "Rose Gold / 18in".
  title             String
  /// Structured options so the PDP can render one selector per dimension.
  /// Shape: { "Size": "14", "Finish": "Oxidised" }
  options           Json            @default("{}")
  mrpPaise          Int
  pricePaise        Int
  silverWeightGram  Float?
  imageId           String?
  trackInventory    Boolean         @default(true)
  stockQuantity     Int             @default(0)
  lowStockThreshold Int             @default(3)
  /// Reserved by in-flight (created but unpaid) orders. Available stock is
  /// `stockQuantity - reservedQuantity`.
  reservedQuantity  Int             @default(0)
  position          Int             @default(0)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  cartItems         CartItem[]
  orderItems        OrderItem[]
  image             Media?          @relation("VariantImage", fields: [imageId], references: [id])
  product           Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  stockMovements    StockMovement[]

  @@index([productId, position])
  @@map("product_variants")
}

/// Append-only ledger of every stock change. Makes "why is this out of stock?"
/// answerable, and is the audit trail behind oversell investigations.
model StockMovement {
  id        String         @id @default(cuid())
  variantId String
  /// Negative for a sale, positive for a restock or cancellation release.
  delta     Int
  /// Stock level after this movement was applied.
  balance   Int
  /// "order.paid", "order.cancelled", "admin.adjustment", "seed"
  reason    String
  orderId   String?
  /// Staff user id for manual adjustments.
  actorId   String?
  note      String?
  createdAt DateTime       @default(now())
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@index([variantId, createdAt])
  @@index([orderId])
  @@map("stock_movements")
}

model ProductImage {
  id        String  @id @default(cuid())
  productId String
  mediaId   String
  /// Falls back to the product name when absent.
  alt       String?
  position  Int     @default(0)
  isPrimary Boolean @default(false)
  media     Media   @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, mediaId])
  @@index([productId, position])
  @@map("product_images")
}

/// Product-specific FAQs. Feeds both the PDP accordion and FAQPage schema.
model ProductFaq {
  id        String  @id @default(cuid())
  productId String
  question  String
  answer    String
  position  Int     @default(0)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId, position])
  @@map("product_faqs")
}

/// Carts are keyed either by user (logged in) or by an anonymous token cookie.
/// On login the anonymous cart is merged into the user's cart.
model Cart {
  id        String     @id @default(cuid())
  userId    String?
  /// Opaque cookie value for guest carts.
  token     String     @unique
  couponId  String?
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  expiresAt DateTime
  items     CartItem[]
  coupon    Coupon?    @relation(fields: [couponId], references: [id])
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("carts")
}

model CartItem {
  id        String         @id @default(cuid())
  cartId    String
  productId String
  variantId String
  quantity  Int            @default(1)
  createdAt DateTime       @default(now())
  updatedAt DateTime       @updatedAt
  cart      Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  product   Product        @relation(fields: [productId], references: [id], onDelete: Cascade)
  variant   ProductVariant @relation(fields: [variantId], references: [id], onDelete: Cascade)

  @@unique([cartId, variantId])
  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

model Order {
  id              String        @id @default(cuid())
  /// Human-facing, e.g. "ASJ-2A7F3K".
  orderNumber     String        @unique
  userId          String
  status          OrderStatus   @default(PENDING)
  paymentStatus   PaymentStatus @default(PENDING)
  subtotalPaise   Int
  discountPaise   Int           @default(0)
  taxPaise        Int           @default(0)
  shippingPaise   Int           @default(0)
  totalPaise      Int
  couponId        String?
  /// Snapshot — the coupon may later be deleted.
  couponCode      String?
  shipName        String
  shipMobile      String
  shipEmail       String?
  shipLine1       String
  shipLine2       String?
  shipLandmark    String?
  shipCity        String
  shipState       String
  shipPincode     String
  shipCountry     String        @default("India")
  customerNote    String?
  internalNote    String?
  /// Shared id for Meta Pixel + Conversions API deduplication. Generated once
  /// at order creation and reused by both the browser and server events.
  metaEventId     String?       @unique
  /// Set once the server-side Purchase event has been accepted by Meta, so a
  /// webhook retry cannot double-report revenue.
  metaCapiSentAt  DateTime?
  /// Guards the same for GA4's client-side purchase event.
  analyticsSentAt DateTime?
  placedAt        DateTime?
  cancelledAt     DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  items           OrderItem[]
  coupon          Coupon?       @relation(fields: [couponId], references: [id])
  user            User          @relation(fields: [userId], references: [id])
  payments        Payment[]

  @@index([userId, createdAt])
  @@index([status])
  @@index([paymentStatus])
  @@index([createdAt])
  @@map("orders")
}

/// A full snapshot of what was bought. Deliberately denormalised: a product
/// rename, price change or deletion must not alter a past order.
model OrderItem {
  id               String          @id @default(cuid())
  orderId          String
  productId        String?
  variantId        String?
  productName      String
  variantTitle     String
  sku              String
  slug             String
  imageUrl         String?
  silverPurity     String?
  silverWeightGram Float?
  quantity         Int
  unitMrpPaise     Int
  unitPricePaise   Int
  lineTotalPaise   Int
  taxPercent       Float           @default(3)
  order            Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product          Product?        @relation(fields: [productId], references: [id])
  variant          ProductVariant? @relation(fields: [variantId], references: [id])

  @@index([orderId])
  @@index([productId])
  @@map("order_items")
}

model Payment {
  id                 String          @id @default(cuid())
  orderId            String
  provider           PaymentProvider @default(RAZORPAY)
  status             PaymentStatus   @default(PENDING)
  amountPaise        Int
  currency           String          @default("INR")
  refundedPaise      Int             @default(0)
  /// razorpay_order_id
  providerOrderId    String?         @unique
  /// razorpay_payment_id
  providerPaymentId  String?         @unique
  providerSignature  String?
  /// "upi", "card", "netbanking"
  method             String?
  failureCode        String?
  failureDescription String?
  /// Raw provider payload, retained for reconciliation and dispute handling.
  rawPayload         Json?
  capturedAt         DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  order              Order           @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@index([status])
  @@map("payments")
}

/// Idempotency ledger for inbound provider webhooks. A duplicate delivery finds
/// its event id already present and is acknowledged without reprocessing.
model WebhookEvent {
  id          String    @id @default(cuid())
  /// "razorpay"
  provider    String
  /// Provider's own event identifier.
  eventId     String
  eventType   String
  payload     Json
  processedAt DateTime?
  error       String?
  createdAt   DateTime  @default(now())

  @@unique([provider, eventId])
  @@index([createdAt])
  @@map("webhook_events")
}

model Coupon {
  id               String        @id @default(cuid())
  /// Stored uppercase; matched case-insensitively.
  code             String        @unique
  description      String?
  type             CouponType    @default(PERCENTAGE)
  /// Percent (0–100) when type is PERCENTAGE, paise when type is FLAT.
  value            Int
  minOrderPaise    Int           @default(0)
  maxDiscountPaise Int?
  startsAt         DateTime?
  endsAt           DateTime?
  /// Total redemptions allowed across all customers.
  usageLimit       Int?
  perCustomerLimit Int           @default(1)
  usageCount       Int           @default(0)
  /// Empty array means "applies to everything".
  categoryIds      String[]      @default([])
  productIds       String[]      @default([])
  isActive         Boolean       @default(true)
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  carts            Cart[]
  usages           CouponUsage[]
  orders           Order[]

  @@index([isActive, startsAt, endsAt])
  @@map("coupons")
}

model CouponUsage {
  id            String   @id @default(cuid())
  couponId      String
  userId        String
  orderId       String
  discountPaise Int
  createdAt     DateTime @default(now())
  coupon        Coupon   @relation(fields: [couponId], references: [id], onDelete: Cascade)
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([couponId, orderId])
  @@index([couponId, userId])
  @@map("coupon_usages")
}

model Review {
  id            String       @id @default(cuid())
  productId     String
  userId        String
  /// 1–5, enforced in the application layer and by a check below.
  rating        Int
  title         String?
  body          String?
  /// Cloudinary URLs of customer-uploaded photos.
  imageUrls     String[]     @default([])
  /// Moderation is mandatory.
  status        ReviewStatus @default(PENDING)
  isFeatured    Boolean      @default(false)
  /// True when the user purchased it.
  isVerified    Boolean      @default(false)
  adminResponse String?
  moderatedAt   DateTime?
  moderatedById String?
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt
  product       Product      @relation(fields: [productId], references: [id], onDelete: Cascade)
  user          User         @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([productId, userId])
  @@index([productId, status])
  @@index([status, createdAt])
  @@map("reviews")
}

/// A campaign is a scheduled override of the storefront: its own homepage
/// sections, announcement bar and theme accent. When the window closes the
/// storefront reverts to the default configuration with no manual step.
model Campaign {
  id                  String            @id @default(cuid())
  name                String
  slug                String            @unique
  description         String?
  status              CampaignStatus    @default(DRAFT)
  startsAt            DateTime
  endsAt              DateTime
  /// Higher priority wins when two campaigns overlap.
  priority            Int               @default(0)
  announcementText    String?
  announcementLink    String?
  /// Theme overrides applied as CSS custom properties on <html>.
  /// Shape: { "accent": "#8C6B3F", "accentContrast": "#FFFFFF" }
  theme               Json?
  couponId            String?
  featuredCategoryIds String[]          @default([])
  featuredProductIds  String[]          @default([])
  createdAt           DateTime          @default(now())
  updatedAt           DateTime          @updatedAt
  sections            HomepageSection[]

  @@index([status, startsAt, endsAt])
  @@map("campaigns")
}

/// One row per homepage block. Rows with `campaignId = null` form the default
/// homepage; rows attached to a campaign replace it while that campaign is
/// live. Per-section scheduling works independently of campaigns.
model HomepageSection {
  id         String      @id @default(cuid())
  campaignId String?
  type       SectionType
  /// Internal label shown in the admin list, e.g. "Diwali hero".
  label      String
  position   Int         @default(0)
  isActive   Boolean     @default(true)
  startsAt   DateTime?
  endsAt     DateTime?
  /// Type-specific configuration, validated against a per-type Zod schema in
  /// src/lib/cms/sections.ts before it is written.
  settings   Json        @default("{}")
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  campaign   Campaign?   @relation(fields: [campaignId], references: [id], onDelete: Cascade)

  @@index([campaignId, position])
  @@index([isActive, position])
  @@map("homepage_sections")
}

model Media {
  id               String           @id @default(cuid())
  folder           MediaFolder      @default(OTHER)
  /// Cloudinary public id — the handle used to build transformation URLs.
  publicId         String           @unique
  url              String
  /// Cloudinary needs the secure delivery URL for OG tags and the Meta feed.
  secureUrl        String
  format           String?
  width            Int?
  height           Int?
  bytes            Int?
  /// Tiny base64 placeholder for blurred image loading.
  blurDataUrl      String?
  alt              String?
  filename         String?
  tags             String[]         @default([])
  uploadedById     String?
  createdAt        DateTime         @default(now())
  categoryImages   Category[]       @relation("CategoryImage")
  categoryOgImages Category[]       @relation("CategoryOgImage")
  collectionImages Collection[]     @relation("CollectionImage")
  productImages    ProductImage[]
  variantImages    ProductVariant[] @relation("VariantImage")
  productOgImages  Product[]        @relation("ProductOgImage")

  @@index([folder, createdAt])
  @@map("media")
}

/// Site-wide FAQs (as distinct from ProductFaq). Rendered on /faq and available
/// to the FAQ homepage section.
model Faq {
  id        String   @id @default(cuid())
  question  String
  answer    String
  /// "Shipping", "Returns", "Care"
  category  String?
  position  Int      @default(0)
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([isActive, position])
  @@map("faqs")
}

/// SEO overrides for routes that are not backed by a catalogue record
/// (/about, /contact, /faq, policy pages).
model SeoMeta {
  id            String   @id @default(cuid())
  /// "/about"
  path          String   @unique
  title         String?
  description   String?
  canonical     String?
  ogTitle       String?
  ogDescription String?
  ogImageUrl    String?
  noindex       Boolean  @default(false)
  updatedAt     DateTime @updatedAt

  @@map("seo_meta")
}

/// Typed key/value store for editable site settings (contact details, shipping
/// thresholds, social links). Avoids a column-per-setting migration treadmill.
model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt

  @@map("settings")
}

model NewsletterSubscriber {
  id             String    @id @default(cuid())
  email          String    @unique
  /// "footer", "popup", "checkout"
  source         String?
  isActive       Boolean   @default(true)
  unsubscribedAt DateTime?
  createdAt      DateTime  @default(now())

  @@map("newsletter_subscribers")
}

/// Outbound message log. Every WhatsApp/email/SMS send is recorded so failures
/// are visible in the admin and retryable rather than silently lost.
model Notification {
  id                String              @id @default(cuid())
  channel           NotificationChannel
  status            NotificationStatus  @default(QUEUED)
  recipient         String
  /// "order.placed", "payment.received", "otp.login"
  template          String
  payload           Json?
  providerMessageId String?
  error             String?
  attempts          Int                 @default(0)
  orderId           String?
  userId            String?
  sentAt            DateTime?
  createdAt         DateTime            @default(now())

  @@index([status, createdAt])
  @@index([orderId])
  @@map("notifications")
}

/// Who changed what, when. Written by every mutating admin action.
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  /// "product.update", "order.cancel"
  action     String
  /// "Product"
  entityType String
  entityId   String?
  /// Field-level before/after for the changed keys only.
  changes    Json?
  ip         String?
  userAgent  String?
  createdAt  DateTime @default(now())
  user       User?    @relation(fields: [userId], references: [id])

  @@index([entityType, entityId])
  @@index([userId, createdAt])
  @@index([createdAt])
  @@map("audit_logs")
}

enum Role {
  CUSTOMER
  CONTENT_MANAGER
  MARKETING_MANAGER
  ORDER_MANAGER
  PRODUCT_MANAGER
  ADMIN
  SUPER_ADMIN
}

enum UserStatus {
  ACTIVE
  BLOCKED
}

enum OtpChannel {
  SMS
  EMAIL
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum Gender {
  WOMEN
  MEN
  UNISEX
  KIDS
}

enum OrderStatus {
