# =============================================================================
# AASTHA SILVER & JEWELS — Environment Configuration
# =============================================================================
# Copy this file to `.env` and fill in real values.
# NEVER commit `.env`. Only this example file belongs in git.
#
# Variables prefixed with NEXT_PUBLIC_ are embedded in the browser bundle and
# are therefore PUBLIC. Never put a secret behind a NEXT_PUBLIC_ prefix.
# =============================================================================


# -----------------------------------------------------------------------------
# CORE
# -----------------------------------------------------------------------------
# Canonical public origin. Used for canonical URLs, sitemap, OG tags, Razorpay
# callbacks and the Meta product feed. No trailing slash.
NEXT_PUBLIC_SITE_URL="https://aasthasilverandjewels.in"

# "development" | "production" | "test"
NODE_ENV="development"


# -----------------------------------------------------------------------------
# DATABASE — PostgreSQL
# -----------------------------------------------------------------------------
# Neon: https://console.neon.tech → Project → Connection string (pooled).
# Local dev alternative: run `npx prisma dev` and paste the URL it prints.
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# Direct (non-pooled) connection. Required by `prisma migrate` when DATABASE_URL
# points at a connection pooler such as PgBouncer or Neon's pooled endpoint.
# If you are not using a pooler, set this to the same value as DATABASE_URL.
DIRECT_DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"


# -----------------------------------------------------------------------------
# SESSION / AUTH
# -----------------------------------------------------------------------------
# Signing key for customer and admin session JWTs. Minimum 32 characters.
# Generate with:  openssl rand -base64 48
SESSION_SECRET="replace-me-with-a-long-random-string-min-32-chars"

# Pepper mixed into OTP hashes before storage. Rotating this invalidates all
# in-flight OTPs (safe to do). Generate with:  openssl rand -base64 32
OTP_PEPPER="replace-me-with-another-long-random-string"

# Comma-separated mobile numbers (E.164, no +) that are granted ADMIN on login.
# Used only to bootstrap the first admin; afterwards manage roles in /admin.
ADMIN_BOOTSTRAP_MOBILES="919999999999"


# -----------------------------------------------------------------------------
# SMS OTP — MSG91
# -----------------------------------------------------------------------------
# Dashboard: https://control.msg91.com
# Driver: "msg91" sends real SMS. "console" prints the OTP to the server log
# and is the correct setting for local development.
SMS_DRIVER="console"
MSG91_AUTH_KEY=""
MSG91_SENDER_ID="AASTHA"
# DLT-approved template containing the ##OTP## variable.
MSG91_OTP_TEMPLATE_ID=""


# -----------------------------------------------------------------------------
# PAYMENTS — Razorpay
# -----------------------------------------------------------------------------
# Dashboard: https://dashboard.razorpay.com/app/website-app-settings/api-keys
# Use rzp_test_* keys in development.
# KEY_ID is safe to expose to the browser; KEY_SECRET must never leave the server.
NEXT_PUBLIC_RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Settings → Webhooks → create endpoint POST {SITE_URL}/api/webhooks/razorpay
# Subscribe to: payment.captured, payment.failed, order.paid, refund.processed
RAZORPAY_WEBHOOK_SECRET=""


# -----------------------------------------------------------------------------
# MEDIA STORAGE — Cloudinary
# -----------------------------------------------------------------------------
# Dashboard: https://console.cloudinary.com → Settings → API Keys
NEXT_PUBLIC_CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
# Folder prefix for all uploads from this store.
CLOUDINARY_FOLDER="aastha"


# -----------------------------------------------------------------------------
# WHATSAPP — Meta WhatsApp Cloud API
# -----------------------------------------------------------------------------
# Setup: https://developers.facebook.com → your app → WhatsApp → API Setup
# Driver: "cloud" sends real messages. "console" logs them (local development).
WHATSAPP_DRIVER="console"
WHATSAPP_ACCESS_TOKEN=""
WHATSAPP_PHONE_NUMBER_ID=""
WHATSAPP_BUSINESS_ACCOUNT_ID=""

# Public-facing support number shown on the order confirmation page and in the
# floating WhatsApp CTA. E.164 without the leading "+".
NEXT_PUBLIC_SUPPORT_WHATSAPP="919116662871"


# -----------------------------------------------------------------------------
# TRANSACTIONAL EMAIL — Resend
# -----------------------------------------------------------------------------
# Dashboard: https://resend.com/api-keys
EMAIL_DRIVER="console"
RESEND_API_KEY=""
EMAIL_FROM="Aastha Silver & Jewels <aasthasilverandjewels@gmail.com>"


# -----------------------------------------------------------------------------
# META PIXEL + CONVERSIONS API
# -----------------------------------------------------------------------------
# Events Manager: https://business.facebook.com/events_manager2
# The Pixel ID is public. The CAPI access token is a server secret.
NEXT_PUBLIC_META_PIXEL_ID=""
META_CAPI_ACCESS_TOKEN=""
# Optional: while testing, paste the code from Events Manager → Test Events so
# CAPI events land in the test stream instead of production. Leave blank in prod.
META_CAPI_TEST_EVENT_CODE=""


# -----------------------------------------------------------------------------
# GOOGLE ANALYTICS 4 + TAG MANAGER
# -----------------------------------------------------------------------------
NEXT_PUBLIC_GA4_MEASUREMENT_ID=""
NEXT_PUBLIC_GTM_CONTAINER_ID=""


# -----------------------------------------------------------------------------
# SCHEDULED JOBS
# -----------------------------------------------------------------------------
# Shared secret required by /api/cron/* endpoints. Vercel Cron sends this as
# `Authorization: Bearer <CRON_SECRET>`. Generate with: openssl rand -hex 32
CRON_SECRET=""
